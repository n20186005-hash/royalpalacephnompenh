---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, buildAlternates, htmlLangAttr, getI18n, defaultLang, languagesList, localizedPath } from '../i18n/ui';
import { ogLocale, siteConfig, resolveBaseUrl, pwaConfig } from '../config';
import { poi, galleryImages } from '../data/poi';

interface Props {
  title: string;
  description: string;
  path?: string;
  /** Optional locale override; by default the locale is read from the URL. */
  lang?: string;
}

const { title, description, path = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);

// Canonical/alternate URLs: use the explicit `path` prop when given, otherwise
// derive the slug from the request (minus the locale segment) so legal pages
// keep their own canonical URL instead of falling back to the home page.
const segments = Astro.url.pathname.replace(/\/+$/, '').split('/').filter(Boolean);
// The default locale (km) is unprefixed at the root, so only a non-default
// prefix (en/zh) should be stripped when deriving the canonical page slug.
const firstSeg = segments[0];
const isNonDefaultPrefix = firstSeg && firstSeg !== defaultLang && (languagesList as readonly string[]).includes(firstSeg);
const pagePath = path || (isNonDefaultPrefix ? segments.slice(1).join('/') : segments.join('/'));
const isGuidePage = pagePath === '';
const htmlLang = htmlLangAttr(lang);
const alts = buildAlternates(pagePath);
const canonical = alts[lang] ?? alts.xDefault;
const { messages } = getI18n(Astro.url);
const SITE = resolveBaseUrl();
const attractionName = messages.header?.siteName ?? poi.name[lang] ?? poi.name.en;
const localName = poi.name[lang] ?? poi.name.en;
const localShortName = poi.shortName[lang] ?? poi.shortName.en;
const localOpening = poi.opening[lang] ?? poi.opening.en;
const localCategory = poi.category[lang] ?? poi.category.en;

// --- Entity binding: stable IDs used across every schema graph on the page ---
const ATTRACTION_ID = `${SITE}/#attraction`;
const WEBSITE_ID = `${SITE}/#website`;
const ORG_ID = `${SITE}/#organization`;

// Alternate names: official Khmer name, the domain name, the traditional
// Chinese form, plus the locale short name and "City + official name".
const alternateNames = [
  'ព្រះបរមរាជវាំងចតុមុខមង្គល',
  'Royal Palace Phnom Penh',
  '金邊皇宮',
  localName,
  localShortName,
  `${poi.city} ${poi.name.en}`,
].filter((v, i, arr) => Boolean(v) && arr.indexOf(v) === i);

// Hero + a few gallery shots so Google can render the attraction card.
const images = [SITE + poi.heroImage, ...galleryImages.slice(1, 5).map((src) => SITE + src)];

// Entity card for the search results page: a TouristAttraction that is also a
// HistoricalLandmark. The Google Maps rating/review count is synced from the
// place listing (the visible source note stays in the reviews section); the
// review text itself remains display-only — no Review markup.
const attractionLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'HistoricalLandmark'],
  '@id': ATTRACTION_ID,
  name: localName,
  alternateName: alternateNames,
  description: description,
  url: canonical,
  image: images,
  mainEntityOfPage: { '@id': WEBSITE_ID },
  isPartOf: { '@id': WEBSITE_ID },
  isAccessibleForFree: true,
  touristType: ['Culture', 'History', 'Sightseeing'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: poi.streetAddress,
    addressLocality: poi.city,
    addressRegion: poi.region,
    postalCode: poi.postalCode,
    addressCountry: poi.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    // Same source of truth as the map embed and plus code (poi.lat / poi.lng,
    // synced from the Google Maps listing) so the entity card pin matches.
    latitude: String(poi.lat),
    longitude: String(poi.lng),
  },
  hasMap: poi.mapsUrl,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: String(poi.rating),
    reviewCount: String(poi.reviews),
    bestRating: '5',
    worstRating: '1',
  },
  sameAs: [poi.mapsUrl, poi.website, poi.govtTourismUrl],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '08:00',
      closes: '11:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '14:00',
      closes: '17:00',
    },
  ],
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Google plus code', value: poi.plusCode },
    { '@type': 'PropertyValue', name: 'Category', value: localCategory },
    { '@type': 'PropertyValue', name: 'Opening hours', value: localOpening },
  ],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  name: attractionName,
  url: SITE,
  inLanguage: ['km', 'en', 'zh-CN'],
  about: { '@id': ATTRACTION_ID },
  publisher: {
    '@type': 'Organization',
    '@id': ORG_ID,
    name: attractionName,
    url: SITE,
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${SITE}/#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: messages.common.home, item: `${SITE}${localizedPath(lang)}` },
    { '@type': 'ListItem', position: 2, name: `${poi.city}, ${poi.country}`, item: `${SITE}${localizedPath(lang)}#map` },
    { '@type': 'ListItem', position: 3, name: localName, item: canonical },
  ],
};

const faqItems = messages.faq?.items ?? [];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${SITE}${localizedPath(lang)}#faq`,
  mainEntity: faqItems.map((it: { q: string; a: string }) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="km" href={alts.km} />
    <link rel="alternate" hreflang="en" href={alts.en} />
    <link rel="alternate" hreflang="zh" href={alts.zh} />
    <link rel="alternate" hreflang="x-default" href={alts.xDefault} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang] ?? lang} />
    <meta property="og:site_name" content={attractionName} />
    <meta property="og:image" content={SITE + poi.heroImage} />
    <meta property="og:image:alt" content={`${localName} in ${poi.city}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={SITE + poi.heroImage} />
    <meta name="twitter:image:alt" content={`${localName} in ${poi.city}`} />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={pwaConfig.themeColor} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={pwaConfig.shortName} />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(attractionLd)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)}></script>
    {isGuidePage && faqItems.length > 0 && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)}></script>
    )}

    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>

    <!-- PWA service worker registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-white text-slate-900" style="background: var(--bg-primary); color: var(--text-primary);">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
