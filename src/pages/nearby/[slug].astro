---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NearbyDetail from '../../components/NearbyDetail.astro';
import { nearbyGuides } from '../../data/nearbyGuides';
export function getStaticPaths() { return nearbyGuides.map(place=>({params:{slug:place.slug},props:{place}})); }
const {place}=Astro.props;
---
<BaseLayout lang="km" title={place.content.km.title} description={place.content.km.intro} nearbyPlace={place}><NearbyDetail lang="km" place={place}/></BaseLayout>
