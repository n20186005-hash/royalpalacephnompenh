---
import km from '../../i18n/km.json';
import en from '../../i18n/en.json';
import zh from '../../i18n/zh.json';
import HomePage from '../../components/HomePage.astro';

const dict: Record<string, any> = { km, en, zh };

// Only en/zh live under a prefix. The default locale (km) is served directly
// at the root "/" by src/pages/index.astro, so it is deliberately excluded
// here to avoid a duplicate /km/ route.
export function getStaticPaths() {
  return (['en', 'zh'] as const).map((lang) => ({ params: { lang } }));
}

const lang = String(Astro.params.lang);
const messages = dict[lang];
---

<HomePage lang={lang} messages={messages} />
