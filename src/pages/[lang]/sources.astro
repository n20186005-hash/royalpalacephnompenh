---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sources from '../../components/Sources.astro';
import { getI18n, languagesList } from '../../i18n/ui';

export function getStaticPaths() {
  return languagesList.filter((l) => l !== 'km').map((lang) => ({ params: { lang } }));
}
const { messages } = getI18n(Astro.url);
---

<BaseLayout title={`${messages.attribution.sourcesTitle} · ${messages.footer.siteName}`} description={messages.attribution.sourcesIntro}>
  <Sources />
</BaseLayout>
