---
// Khmer (default) cookie settings served directly at "/cookie-settings/".
// en/zh variants live under /[lang]/cookie-settings.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalLayout from '../components/LegalLayout.astro';
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const title = messages.legal.cookieTitle;
const meta = messages.footer?.siteName ?? messages.header?.siteName ?? '';
---

<BaseLayout
  title={`${title} · ${meta}`}
  description={messages.legal.cookie.intro}
>
  <LegalLayout kind="cookie" />
</BaseLayout>
