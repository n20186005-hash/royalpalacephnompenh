---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const h = messages.heritage;
const f = messages.footer;
---

<section id="about-site" class="section-shell-alt">
  <div class="max-w-4xl mx-auto px-4 py-12 sm:py-16 text-center">
    <h2 class="font-display text-3xl sm:text-4xl font-bold" style="color: var(--text-primary);">{h.closingTitle}</h2>
    <p class="mt-5 text-sm sm:text-base leading-relaxed" style="color: var(--text-secondary);">{h.closingText}</p>
    <p class="mt-3 text-sm leading-relaxed" style="color: var(--text-secondary);">{f.statement}</p>
  </div>
</section>
