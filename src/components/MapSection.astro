---
import { getI18n } from '../i18n/ui';
import { poi } from '../data/poi';
import { siteConfig } from '../config';

const { lang, messages } = getI18n(Astro.url);
const mapsUrl = messages.mapsUrl ?? poi.mapsUrl;
const h = messages.header;
const m = messages.mapSection ?? {};
const attr = messages.attribution ?? {};
const fullName = poi.name[lang] ?? poi.name.en;
const localOpening = poi.opening[lang] ?? poi.opening.en;
---

<section id="map" class="section-shell-alt">
  <div class="max-w-6xl mx-auto px-4 py-16 sm:py-20">
    <div class="text-center mb-8">
      <h2 class="font-display text-3xl sm:text-4xl font-bold" style="color: var(--text-primary);">{m.title ?? h.map}</h2>
      <p class="mt-3 text-sm" style="color: var(--text-secondary);">{poi.address}</p>
    </div>

    <div class="rounded-2xl overflow-hidden border" style="border-color: var(--border-color);">
      <iframe
        title={`${fullName} map`}
        class="w-full h-[420px]"
        style="border:0;"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
        src={siteConfig.mapsEmbedUrl}>
      </iframe>
    </div>

    <dl class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4 max-w-4xl mx-auto text-sm">
      <div class="rounded-2xl p-4" style="background: var(--card-bg); border: 1px solid var(--border-color);">
        <dt class="text-[11px] uppercase tracking-wide mb-1" style="color: var(--text-muted);">{m.addressLabel ?? 'Address'}</dt>
        <dd style="color: var(--text-primary);">{poi.address}</dd>
      </div>
      <div class="rounded-2xl p-4" style="background: var(--card-bg); border: 1px solid var(--border-color);">
        <dt class="text-[11px] uppercase tracking-wide mb-1" style="color: var(--text-muted);">{m.plusCodeLabel ?? 'Google plus code'}</dt>
        <dd style="color: var(--text-primary);">{poi.plusCode}</dd>
      </div>
      <div class="rounded-2xl p-4" style="background: var(--card-bg); border: 1px solid var(--border-color);">
        <dt class="text-[11px] uppercase tracking-wide mb-1" style="color: var(--text-muted);">{m.coordsLabel ?? 'Coordinates'}</dt>
        <dd style="color: var(--text-primary);">{poi.lat}, {poi.lng}</dd>
      </div>
      <div class="rounded-2xl p-4" style="background: var(--card-bg); border: 1px solid var(--border-color);">
        <dt class="text-[11px] uppercase tracking-wide mb-1" style="color: var(--text-muted);">{m.hoursLabel ?? 'Opening hours'}</dt>
        <dd style="color: var(--text-primary);">{localOpening}</dd>
      </div>
    </dl>

    <div class="mt-6 text-center">
      <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-cta btn-cta-primary">
        🗺️ {messages.hero.ctaMaps}
      </a>
    </div>

    <p class="mt-6 text-xs text-center max-w-3xl mx-auto leading-relaxed" style="color: var(--text-muted);">
      {attr.govtText}
      {' '}
      <a href={poi.govtTourismUrl} target="_blank" rel="noopener noreferrer" class="underline" style="color: var(--color-ocean-600, #0369a1);">
        {attr.govtCta ?? 'Official Tourism Portal'}
      </a>
      {' · '}
      <a href={poi.cityHallUrl} target="_blank" rel="noopener noreferrer" class="underline" style="color: var(--color-ocean-600, #0369a1);">
        {attr.cityHallName ?? 'Phnom Penh City Hall'}
      </a>
    </p>

    <p class="mt-2 text-xs text-center" style="color: var(--text-muted);">
      <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="underline" style="color: var(--color-ocean-600, #0369a1);">
        {attr.ratingCta ?? 'View all reviews on Google Maps'}
      </a>
    </p>
  </div>
</section>
