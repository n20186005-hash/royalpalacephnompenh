---
import { getI18n } from '../i18n/ui';
import { poi } from '../data/poi';

const { lang, messages } = getI18n(Astro.url);
const r = messages.reviews;
const attr = messages.attribution ?? {};
const likes = r.likes ?? [];
const tips = r.tips ?? [];
const mapsUrl = messages.mapsUrl ?? poi.mapsUrl;
const reviewCount = poi.reviews.toLocaleString(lang === 'zh' ? 'zh-CN' : 'en-US');
const fullName = poi.name[lang] ?? poi.name.en;
const fullStars = Math.round(poi.rating);
---

<section id="reviews" class="section-shell-alt">
  <div class="max-w-4xl mx-auto px-4 py-16 sm:py-20">
    <div class="text-center mb-12">
      <h2 class="font-display text-3xl sm:text-4xl font-bold" style="color: var(--text-primary);">{r.title}</h2>
      {r.intro && <p class="mt-3 max-w-2xl mx-auto text-base sm:text-lg" style="color: var(--text-secondary);">{r.intro}</p>}
    </div>

    <div class="rounded-3xl p-8 text-center mb-4" style="background: var(--card-bg); border: 1px solid var(--border-color);">
      <div class="text-5xl font-display font-bold" style="color: var(--color-ocean-600, #0369a1);">{poi.rating}</div>
      <div class="text-amber-400 text-xl my-1" aria-hidden="true">{'★'.repeat(fullStars)}<span style="color: var(--text-muted);">{'★'.repeat(5 - fullStars)}</span></div>
      <p class="text-sm" style="color: var(--text-secondary);">{r.ratingLabel}: <strong>{poi.rating} / 5</strong> · {reviewCount} {r.reviewCountLabel}</p>
    </div>

    <!-- Visible source note for Google Maps ratings (kept out of JSON-LD on purpose). -->
    <p class="text-xs leading-relaxed text-center mb-10 mx-auto max-w-3xl" style="color: var(--text-muted);">
      {attr.reviewsNote}
    </p>

    <div class="grid gap-5 sm:grid-cols-2">
      <div class="rounded-2xl p-6" style="background: var(--card-bg); border: 1px solid var(--border-color);">
        <h3 class="font-semibold mb-4" style="color: var(--text-primary);">{r.likesTitle}</h3>
        <ul class="space-y-2 text-sm" style="color: var(--text-secondary);">
          {likes.map((l) => (
            <li class="flex items-start gap-2"><span style="color: var(--color-ocean-600, #0369a1);">✓</span><span>{l}</span></li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl p-6" style="background: var(--card-bg); border: 1px solid var(--border-color);">
        <h3 class="font-semibold mb-4" style="color: var(--text-primary);">{r.tipsTitle}</h3>
        <ul class="space-y-2 text-sm" style="color: var(--text-secondary);">
          {tips.map((t) => (
            <li class="flex items-start gap-2"><span style="color: #d97706;">!</span><span>{t}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 text-center">
      <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-cta btn-cta-primary">
        🗺️ {attr.reviewsCta ?? 'View all reviews on Google Maps'}
      </a>
      <p class="mt-3 text-xs" style="color: var(--text-muted);">
        {attr.reviewsSourceName ?? `${fullName} — Google Maps`}
      </p>
    </div>
  </div>
</section>
