---
import { getI18n } from '../i18n/ui';
import { localizedPath } from '../i18n/ui';
import { extendedTopic } from '../data/extendedTopics';
import { topicPhotos } from '../data/topicEnhancements';
import { nearbyGuides } from '../data/nearbyGuides';

const { messages } = getI18n(Astro.url);
const n = messages.nearby;
const items = n.items ?? [];
const { lang } = getI18n(Astro.url);
const guides = ['throne-hall', 'moonlight-pavilion', 'royal-palace-history', 'palace-walking-route', 'royal-palace-photography'].map((slug) => ({ slug, data: extendedTopic(lang, slug), photo: topicPhotos[slug]?.[0] }));
const guidesHeading = lang === 'zh' ? '继续探索王宫建筑与游览路线' : lang === 'km' ? 'ស្វែងយល់បន្ថែមពីស្ថាបត្យកម្ម និងផ្លូវទស្សនា' : 'Explore palace landmarks and walking guides';
---

<section id="nearby" class="section-shell-alt">
  <div class="max-w-5xl mx-auto px-4 py-16 sm:py-20">
    <div class="text-center mb-12">
      <h2 class="font-display text-3xl sm:text-4xl font-bold" style="color: var(--text-primary);">{n.title}</h2>
      {n.intro && <p class="mt-3 max-w-2xl mx-auto text-base sm:text-lg" style="color: var(--text-secondary);">{n.intro}</p>}
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {items.map((it, i) => (
        <a href={localizedPath(lang, `nearby/${['national-museum-of-cambodia','sisowath-quay','wat-phnom','central-market'][i]}`)} class="flex items-center justify-between rounded-2xl p-5 hover:opacity-85" style="background: var(--card-bg); border: 1px solid var(--border-color);">
          <div class="flex items-center gap-3">
            <span class="text-xl" aria-hidden="true">📍</span>
            <span class="font-medium" style="color: var(--text-primary);">{it.name}</span>
          </div>
          <span class="text-xs px-3 py-1 rounded-full" style="background: var(--color-ocean-50, #f0f9ff); color: var(--color-ocean-700, #075985);">{it.distance}</span>
        </a>
      ))}
    </div>
    <div class="mt-12">
      <h3 class="font-display text-2xl font-bold mb-5" style="color: var(--text-primary);">{lang === 'zh' ? '探索王宫周边景点' : lang === 'km' ? 'ស្វែងយល់ពីកន្លែងទស្សនាក្បែរព្រះបរមរាជវាំង' : 'Explore nearby attractions'}</h3>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {nearbyGuides.map((place) => <a href={localizedPath(lang,`nearby/${place.slug}`)} class="card overflow-hidden block hover:opacity-90" style="border: 1px solid var(--border-color);">
          <img src={place.photo} alt={place.name} class="w-full h-36 object-cover" loading="lazy" />
          <div class="p-4"><h4 class="font-semibold" style="color: var(--text-primary);">{place.content[lang].title}</h4><p class="mt-2 text-sm line-clamp-2" style="color: var(--text-secondary);">{place.content[lang].intro}</p></div>
        </a>)}
      </div>
    </div>
    <div class="mt-12">
      <h3 class="font-display text-2xl font-bold mb-5" style="color: var(--text-primary);">{guidesHeading}</h3>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {guides.map((guide) => <a href={localizedPath(lang, guide.slug)} class="card overflow-hidden block hover:opacity-90" style="border: 1px solid var(--border-color);">
          {guide.photo && <img src={guide.photo.src} alt={guide.photo.alt[lang] ?? guide.photo.alt.en} loading="lazy" decoding="async" class="w-full h-36 object-cover" />}
          <div class="p-4">
            <h4 class="font-semibold" style="color: var(--text-primary);">{guide.data?.title}</h4>
            <p class="mt-2 text-sm line-clamp-2" style="color: var(--text-secondary);">{guide.data?.intro}</p>
          </div>
        </a>)}
      </div>
    </div>
  </div>
</section>
