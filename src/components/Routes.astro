---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const r = messages.routes;
const routes = [r?.halfDay, r?.fullDay].filter(Boolean);
---

<section id="routes" class="section-shell">
  <div class="max-w-5xl mx-auto px-4 py-16 sm:py-20">
    <div class="text-center mb-12">
      <h2 class="font-display text-3xl sm:text-4xl font-bold" style="color: var(--text-primary);">{r.title}</h2>
      {r.intro && <p class="mt-3 max-w-2xl mx-auto text-base sm:text-lg" style="color: var(--text-secondary);">{r.intro}</p>}
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      {routes.map((route) => (
        <div class="card p-6 sm:p-7">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-semibold text-lg" style="color: var(--text-primary);">{route.title}</h3>
            <span class="chip">{route.duration}</span>
          </div>
          {route.label && <p class="mt-1 text-xs" style="color: var(--text-muted);">{route.label}</p>}

          <ol class="mt-5 space-y-0 timeline">
            {route.steps?.map((step, i) => (
              <li class="timeline-node">
                <div>
                  <span class="timeline-dot"></span>
                  {i < (route.steps?.length ?? 0) - 1 && <span class="timeline-line"></span>}
                </div>
                <div class="pb-4">
                  <p class="text-xs font-semibold tracking-wide" style="color: var(--color-ocean-600, #0369a1);">{step.time}</p>
                  <p class="mt-0.5 text-sm leading-relaxed" style="color: var(--text-secondary);">{step.text}</p>
                </div>
              </li>
            ))}
          </ol>

          {route.note && (
            <p class="mt-2 pt-4 text-xs leading-relaxed" style="color: var(--text-muted); border-top: 1px solid var(--border-color);">{route.note}</p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
