---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const s = messages.services;
const items = s?.items ?? [];
---

<section id="services" class="section-shell">
  <div class="max-w-5xl mx-auto px-4 py-16 sm:py-20">
    <div class="text-center mb-10">
      <h2 class="font-display text-3xl sm:text-4xl font-bold" style="color: var(--text-primary);">{s.title}</h2>
      {s.intro && <p class="mt-3 max-w-3xl mx-auto text-base sm:text-lg" style="color: var(--text-secondary);">{s.intro}</p>}
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <div class="card p-5 flex flex-col">
          <span class="text-2xl" aria-hidden="true">{item.icon}</span>
          <h3 class="mt-2.5 font-semibold text-sm" style="color: var(--text-primary);">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed flex-1" style="color: var(--text-secondary);">{item.text}</p>
          {item.tip && (
            <p class="mt-3 pt-3 text-xs leading-relaxed" style="color: var(--text-muted); border-top: 1px solid var(--border-color);">
              {item.tip}
            </p>
          )}
        </div>
      ))}
    </div>

    {s.neutralNote && (
      <p class="mt-6 text-xs text-center leading-relaxed max-w-3xl mx-auto" style="color: var(--text-muted);">{s.neutralNote}</p>
    )}
  </div>
</section>
