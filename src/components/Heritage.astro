---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const h = messages.heritage;
const items = h?.items ?? [];
const legends = h?.legends ?? [];
const rules = h?.responsibility ?? [];
---

<section id="heritage" class="section-shell">
  <div class="max-w-5xl mx-auto px-4 py-16 sm:py-20">
    <div class="text-center mb-12">
      <h2 class="font-display text-3xl sm:text-4xl font-bold" style="color: var(--text-primary);">{h.title}</h2>
      {h.intro && <p class="mt-3 max-w-3xl mx-auto text-base sm:text-lg" style="color: var(--text-secondary);">{h.intro}</p>}
    </div>

    <!-- Reading the architecture -->
    <h3 class="font-semibold text-lg mb-4" style="color: var(--text-primary);">🧭 {h.knowledgeTitle}</h3>
    <div class="grid gap-4 sm:grid-cols-2">
      {items.map((item) => (
        <div class="card p-5">
          <h4 class="font-semibold text-sm" style="color: var(--text-primary);">{item.title}</h4>
          <p class="mt-2 text-sm leading-relaxed" style="color: var(--text-secondary);">{item.text}</p>
        </div>
      ))}
    </div>

    <!-- Legends and symbolism -->
    <h3 class="mt-12 font-semibold text-lg mb-4" style="color: var(--text-primary);">📜 {h.legendsTitle}</h3>
    <div class="grid gap-4 sm:grid-cols-2">
      {legends.map((legend) => (
        <div class="card p-5" style="border-left: 3px solid var(--color-gold-500, #d4a017);">
          <h4 class="font-semibold text-sm" style="color: var(--text-primary);">{legend.title}</h4>
          <p class="mt-2 text-sm leading-relaxed" style="color: var(--text-secondary);">{legend.text}</p>
        </div>
      ))}
    </div>

    <!-- Visitor responsibility -->
    <div class="mt-12 rounded-2xl p-6 sm:p-7" style="background: var(--card-bg); border: 1px solid var(--border-color);">
      <h3 class="font-semibold text-lg" style="color: var(--text-primary);">🤝 {h.responsibilityTitle}</h3>
      {h.responsibilityIntro && (
        <p class="mt-2 text-sm leading-relaxed" style="color: var(--text-secondary);">{h.responsibilityIntro}</p>
      )}
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        {rules.map((rule) => (
          <li class="flex gap-2.5 text-sm leading-relaxed" style="color: var(--text-secondary);">
            <span class="flex-shrink-0" style="color: var(--color-ocean-600, #0369a1);">✓</span>
            <span>{rule}</span>
          </li>
        ))}
      </ul>
    </div>

    {h.closingText && (
      <div class="mt-8 text-center">
        <p class="text-sm font-semibold" style="color: var(--text-primary);">{h.closingTitle}</p>
        <p class="mt-2 text-xs leading-relaxed max-w-3xl mx-auto" style="color: var(--text-muted);">{h.closingText}</p>
      </div>
    )}
  </div>
</section>
