---
import { getI18n } from '../i18n/ui';
import { poi } from '../data/poi';

const { lang, messages } = getI18n(Astro.url);
const attr = messages.attribution ?? {};
const mapsUrl = messages.mapsUrl ?? poi.mapsUrl;
const fullName = poi.name[lang] ?? poi.name.en;

// External references shown for transparency / E-E-A-T.
// Ratings & reviews live on the page only (never in JSON-LD) and always link
// back to their Google Maps origin, as required by Google's review policies.
const sources: { name: string; url: string; note?: string }[] = [
  {
    name: attr.reviewsSourceName ?? `Google Maps — ${fullName}`,
    url: mapsUrl,
    note: attr.reviewsNote,
  },
  {
    name: `Google Maps — ${poi.address} · ${poi.plusCode}`,
    url: mapsUrl,
  },
  {
    name: attr.cityHallName ?? 'Phnom Penh City Hall',
    url: poi.cityHallUrl,
  },
  {
    name: attr.govtCta ?? 'Cambodia Official Tourism Portal',
    url: poi.govtTourismUrl,
  },
];
---

<section id="sources" class="section-shell">
  <div class="max-w-4xl mx-auto px-4 py-16 sm:py-20">
    <div class="text-center mb-10">
      <h2 class="font-display text-3xl sm:text-4xl font-bold" style="color: var(--text-primary);">{attr.sourcesTitle}</h2>
      {attr.sourcesIntro && (
        <p class="mt-3 max-w-2xl mx-auto text-sm sm:text-base" style="color: var(--text-secondary);">{attr.sourcesIntro}</p>
      )}
    </div>

    <ul class="space-y-3">
      {sources.map((s) => (
        <li class="rounded-2xl p-4 sm:p-5" style="background: var(--card-bg); border: 1px solid var(--border-color);">
          <a href={s.url} target="_blank" rel="noopener noreferrer" class="font-medium hover:underline" style="color: var(--color-ocean-600, #0369a1);">
            {s.name} ↗
          </a>
          {s.note && <p class="mt-1 text-xs leading-relaxed" style="color: var(--text-muted);">{s.note}</p>}
        </li>
      ))}
    </ul>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs" style="color: var(--text-muted);">
      <span class="px-3 py-1 rounded-full" style="background: var(--color-ocean-50, #f0f9ff); color: var(--color-ocean-700, #075985);">
        {attr.syncLabel}
      </span>
      <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="underline" style="color: var(--color-ocean-600, #0369a1);">
        {attr.reviewsCta ?? 'View all reviews on Google Maps'} ↗
      </a>
    </div>

    <p class="mt-8 text-xs text-center leading-relaxed max-w-3xl mx-auto" style="color: var(--text-muted);">
      {attr.govtText}
      {' '}
      <a href={poi.govtTourismUrl} target="_blank" rel="noopener noreferrer" class="underline" style="color: var(--color-ocean-600, #0369a1);">
        {attr.govtCta ?? 'Official Tourism Portal'}
      </a>
    </p>

    <p class="mt-3 text-xs text-center leading-relaxed max-w-3xl mx-auto" style="color: var(--text-muted);">
      <strong>{attr.imageRightsTitle}</strong>{' '}
      {attr.imageRightsNote ?? messages.footer?.imageRights}
    </p>
  </div>
</section>
