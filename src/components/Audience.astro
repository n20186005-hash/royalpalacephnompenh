---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const a = messages.audience;
const groups = a?.groups ?? [];
---

<section id="audience" class="section-shell-alt">
  <div class="max-w-5xl mx-auto px-4 py-16 sm:py-20">
    <div class="text-center mb-12">
      <h2 class="font-display text-3xl sm:text-4xl font-bold" style="color: var(--text-primary);">{a.title}</h2>
      {a.intro && <p class="mt-3 max-w-2xl mx-auto text-base sm:text-lg" style="color: var(--text-secondary);">{a.intro}</p>}
    </div>

    <div class="grid gap-5 lg:grid-cols-3">
      {groups.map((group) => (
        <div class="card p-6 flex flex-col">
          <span class="text-3xl" aria-hidden="true">{group.icon}</span>
          <h3 class="mt-3 font-semibold text-base" style="color: var(--text-primary);">{group.title}</h3>
          <p class="mt-1 text-xs" style="color: var(--color-ocean-600, #0369a1);">{group.duration}</p>

          <ol class="mt-4 space-y-2.5 flex-1">
            {group.steps?.map((step, i) => (
              <li class="flex gap-2.5 text-sm leading-relaxed" style="color: var(--text-secondary);">
                <span
                  class="flex-shrink-0 w-5 h-5 rounded-full text-[11px] font-semibold flex items-center justify-center"
                  style="background: var(--accent-bg); color: var(--accent-text);"
                >
                  {i + 1}
                </span>
                <span>{step}</span>
              </li>
            ))}
          </ol>

          {group.tip && (
            <p class="mt-4 pt-4 text-xs leading-relaxed" style="color: var(--text-muted); border-top: 1px solid var(--border-color);">
              💡 {group.tip}
            </p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
