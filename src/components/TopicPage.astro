---
import { localizedPath } from '../i18n/ui';
import { TOPIC_SLUGS } from '../lib/topics';
import { extendedTopic } from '../data/extendedTopics';
import { poi } from '../data/poi';
import { topicPhotos, topicMaps, topicUi, topicDetails } from '../data/topicEnhancements';
import { topicArea, topicPageCopy } from '../data/topicPageCopy';

interface Props {
  lang: string;
  slug: string;
  data: any;
  messages: any;
}

const { lang, slug, data, messages } = Astro.props;
const t = data ?? {};
const common = messages.common ?? {};
const faqTitle = t.faqTitle ?? messages.faq?.title ?? 'FAQ';
const rich = topicDetails(lang, slug);
const labels = topicUi(lang);
const photos = topicPhotos[slug] ?? [];
const locationUrl = topicMaps[slug] ?? poi.mapsUrl;
const full = topicPageCopy(lang);
const isExterior = slug === 'moonlight-pavilion';

// Other topics in the same language, for cross-linking.
const related = TOPIC_SLUGS.filter((s) => s !== slug).map((s) => ({
  slug: s,
  title: messages.topics?.[s]?.title ?? extendedTopic(lang, s)?.title ?? s,
}));
---

<article class="section-padding">
  <div class="container-page max-w-3xl">
    <p class="section-eyebrow">
      <a href={localizedPath(lang)} class="hover:opacity-70">← {common.home ?? 'Home'}</a>
    </p>
    {rich && <p class="text-sm tracking-wide uppercase mb-3" style="color: var(--text-muted);">{full.tagline}</p>}
    <h1 class="section-title text-3xl sm:text-4xl">{t.title}</h1>
    {t.intro && <p class="section-intro">{t.intro}</p>}

    {rich && <div class="mt-5 grid gap-3 sm:grid-cols-3">
      <div class="card p-4" style="border: 1px solid var(--border-color);">
        <p class="text-xs mb-1" style="color: var(--text-muted);">{full.rating}</p>
        <p class="font-bold text-xl" style="color: var(--text-primary);">★ {poi.rating} <span class="text-sm font-normal">({poi.reviews.toLocaleString('en-US')})</span></p>
        <p class="text-xs" style="color: var(--text-muted);">Google Maps · {poi.reviewSyncPeriod[lang] ?? poi.reviewSyncPeriod.en}</p>
      </div>
      <div class="card p-4" style="border: 1px solid var(--border-color);">
        <p class="text-xs mb-1" style="color: var(--text-muted);">{full.hours}</p>
        <p class="font-semibold" style="color: var(--text-primary);">{poi.opening[lang] ?? poi.opening.en}</p>
      </div>
      <div class="card p-4" style="border: 1px solid var(--border-color);">
        <p class="text-xs mb-1" style="color: var(--text-muted);">{full.price}</p>
        <p class="font-semibold text-lg" style="color: var(--text-primary);">{poi.ticketPrice}</p>
      </div>
    </div>}
    {rich && <p class="mt-3 text-xs leading-relaxed" style="color: var(--text-muted);">{full.palaceScope}</p>}

    {rich && <div class="mt-5 flex flex-wrap items-center gap-3 text-sm">
      <span class="rounded-full px-4 py-2" style="background: var(--bg-secondary); color: var(--text-secondary);">{labels.timing}: {rich.duration}</span>
      <a href={locationUrl} target="_blank" rel="noopener noreferrer" class="rounded-full px-4 py-2 border font-semibold hover:opacity-80" style="border-color: var(--border-color);">📍 {labels.map} ↗</a>
    </div>}

    {rich && photos.length > 0 && <div class="mt-7 grid gap-3 sm:grid-cols-2">
      {photos.map((photo) => <figure class="overflow-hidden rounded-2xl" style="background: var(--bg-secondary);">
        <img src={photo.src} alt={photo.alt[lang] ?? photo.alt.en} loading="lazy" decoding="async" class="w-full h-56 object-cover" />
        <figcaption class="text-xs p-3" style="color: var(--text-muted);">
          {photo.alt[lang] ?? photo.alt.en}
          {photo.src.includes('moonlight-pavilion-phnom-penh') && <a class="ml-2 underline underline-offset-2" href="https://commons.wikimedia.org/wiki/File:Moonlight_Pavilion_of_Royal_Palace_complex,_Phnom_Penh.JPG" target="_blank" rel="noopener noreferrer">Wikimedia Commons ↗</a>}
        </figcaption>
      </figure>)}
    </div>}

    {rich && <section class="mt-9 rounded-2xl p-6 sm:p-8" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
      <h2 class="font-display text-2xl font-bold mb-4" style="color: var(--text-primary);">{labels.managerTitle}</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-secondary);">{labels.manager}</p>
      <p class="leading-relaxed mb-4" style="color: var(--text-secondary);">{labels.heritage}</p>
      <p class="text-sm" style="color: var(--text-muted);">{labels.managerNote}</p>
    </section>}

    {rich && <section class="mt-10">
      <h2 class="font-display text-2xl font-bold mb-4" style="color: var(--text-primary);">{full.facts}</h2>
      <dl class="grid gap-px rounded-xl overflow-hidden border sm:grid-cols-2" style="border-color: var(--border-color); background: var(--border-color);">
        {[
          [full.category, poi.category[lang] ?? poi.category.en],
          [full.area, topicArea(lang, slug)],
          [full.address, poi.address],
          [full.duration, rich.duration],
          [full.manager, lang === 'zh' ? '柬埔寨王宫事务部' : lang === 'km' ? 'ក្រសួងព្រះបរមរាជវាំង' : 'Ministry of the Royal Palace'],
          [full.entry, isExterior ? (lang === 'zh' ? '外部公共区域观赏；入宫另循游客入口' : lang === 'km' ? 'មើលពីខាងក្រៅ; ចូលវាំងតាមច្រកភ្ញៀវ' : 'Public exterior view; palace entry is separate') : (lang === 'zh' ? '按王宫开放动线参观' : lang === 'km' ? 'តាមផ្លូវទស្សនាដែលអនុញ្ញាត' : 'Subject to palace visitor route')],
        ].map(([label, value]) => <div class="p-4" style="background: var(--card-bg);">
          <dt class="text-xs mb-1" style="color: var(--text-muted);">{label}</dt>
          <dd class="font-medium leading-relaxed" style="color: var(--text-primary);">{value}</dd>
        </div>)}
      </dl>
    </section>}

    {rich && <div class="mt-10 grid gap-5 sm:grid-cols-2">
      <section class="card p-6" style="border: 1px solid var(--border-color);">
        <h2 class="font-display text-xl font-bold mb-3" style="color: var(--text-primary);">{full.hoursTitle}</h2>
        <p class="font-semibold mb-2" style="color: var(--text-primary);">{poi.opening[lang] ?? poi.opening.en}</p>
        <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{full.hoursBody}</p>
      </section>
      <section class="card p-6" style="border: 1px solid var(--border-color);">
        <h2 class="font-display text-xl font-bold mb-3" style="color: var(--text-primary);">{full.priceTitle}</h2>
        <p class="font-semibold mb-2" style="color: var(--text-primary);">{poi.ticketPrice}</p>
        <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{full.priceBody}</p>
      </section>
    </div>}

    {t.sections?.length > 0 && (
      <div class="mt-8 space-y-8">
        {t.sections.map((s: any) => (
          <section>
            <h2 class="font-display text-xl sm:text-2xl font-bold mb-2" style="color: var(--text-primary);">{s.heading}</h2>
            <p class="leading-relaxed" style="color: var(--text-secondary);">{s.body}</p>
          </section>
        ))}
      </div>
    )}

    {rich && <div class="mt-10 space-y-9">
      <section>
        <h2 class="font-display text-2xl font-bold mb-3" style="color: var(--text-primary);">{full.discover}</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {[
            [full.history, t.sections?.[0]?.body ?? labels.heritage],
            [full.architecture, rich.features],
            [full.culture, t.sections?.[1]?.body ?? labels.manager],
            [full.experience, rich.photo],
          ].map(([heading, body]) => <div class="card p-5" style="border: 1px solid var(--border-color);">
            <h3 class="font-bold mb-2" style="color: var(--text-primary);">{heading}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{body}</p>
          </div>)}
        </div>
      </section>
      <section>
        <h2 class="font-display text-2xl font-bold mb-3" style="color: var(--text-primary);">{labels.highlights}</h2>
        <p class="leading-relaxed" style="color: var(--text-secondary);">{rich.features}</p>
      </section>
      <section>
        <h2 class="font-display text-2xl font-bold mb-3" style="color: var(--text-primary);">{labels.visit}</h2>
        <ol class="grid gap-3">
          {rich.route.map((step, i) => <li class="card p-4 flex items-start gap-4" style="border: 1px solid var(--border-color);">
            <span class="rounded-full flex items-center justify-center w-8 h-8 shrink-0 font-bold" style="background: var(--bg-secondary); color: var(--text-primary);">{i + 1}</span>
            <span class="leading-relaxed" style="color: var(--text-secondary);">{step}</span>
          </li>)}
        </ol>
      </section>
      <section>
        <h2 class="font-display text-2xl font-bold mb-3" style="color: var(--text-primary);">{labels.photo}</h2>
        <p class="leading-relaxed" style="color: var(--text-secondary);">{rich.photo}</p>
      </section>
      <section>
        <h2 class="font-display text-2xl font-bold mb-3" style="color: var(--text-primary);">{labels.transport}</h2>
        <p class="leading-relaxed mb-3" style="color: var(--text-secondary);">{rich.transport}</p>
        <p class="leading-relaxed mb-3" style="color: var(--text-secondary);">{full.transitBody}</p>
        <p class="text-sm" style="color: var(--text-muted);">{labels.location}: {poi.address}</p>
        <a href={locationUrl} target="_blank" rel="noopener noreferrer" class="inline-block mt-3 underline underline-offset-4">{labels.map} ↗</a>
      </section>
      <section>
        <h2 class="font-display text-2xl font-bold mb-3" style="color: var(--text-primary);">{full.rules}</h2>
        <p class="leading-relaxed" style="color: var(--text-secondary);">{full.rulesBody}</p>
      </section>
      <section>
        <h2 class="font-display text-2xl font-bold mb-3" style="color: var(--text-primary);">{full.stay}</h2>
        <p class="leading-relaxed" style="color: var(--text-secondary);">{full.stayBody}</p>
      </section>
      <section>
        <h2 class="font-display text-2xl font-bold mb-3" style="color: var(--text-primary);">{full.reviews}</h2>
        <p class="leading-relaxed mb-3" style="color: var(--text-secondary);">{full.reviewsBody}</p>
        <p class="font-semibold" style="color: var(--text-primary);">★ {poi.rating} · {poi.reviews.toLocaleString('en-US')} · {poi.reviewSyncPeriod[lang] ?? poi.reviewSyncPeriod.en}</p>
        <a href={poi.mapsUrl} class="inline-block mt-3 underline underline-offset-4" target="_blank" rel="noopener noreferrer">{full.palaceMap} ↗</a>
      </section>
      <section>
        <h2 class="font-display text-2xl font-bold mb-3" style="color: var(--text-primary);">{full.nearby}</h2>
        <p class="leading-relaxed" style="color: var(--text-secondary);">{full.nearbyBody}</p>
      </section>
    </div>}

    <section class="mt-10 card p-6" style="border: 1px solid var(--border-color);">
      <h2 class="font-display text-xl font-bold mb-3" style="color: var(--text-primary);">{rich ? full.map : (lang === 'zh' ? '参观实用信息' : lang === 'km' ? 'ព័ត៌មានសម្រាប់ភ្ញៀវ' : 'Plan your visit')}</h2>
      <dl class="space-y-3 text-sm" style="color: var(--text-secondary);">
        <div><dt class="font-semibold">{lang === 'zh' ? '地址' : lang === 'km' ? 'អាសយដ្ឋាន' : 'Address'}</dt><dd>{poi.address}</dd></div>
        <div><dt class="font-semibold">{lang === 'zh' ? '通常开放时段（以现场为准）' : lang === 'km' ? 'ម៉ោងទស្សនា (សូមបញ្ជាក់នៅទីតាំង)' : 'Usual visiting windows (verify on site)'}</dt><dd>{poi.opening[lang] ?? poi.opening.en}</dd></div>
        <div><dt class="font-semibold">{lang === 'zh' ? '票价参考（以现场为准）' : lang === 'km' ? 'តម្លៃសំបុត្រយោង (សូមបញ្ជាក់នៅទីតាំង)' : 'Admission reference (verify on site)'}</dt><dd>{poi.ticketPrice}</dd></div>
      </dl>
      <a class="inline-block mt-4 underline underline-offset-4" href={locationUrl} target="_blank" rel="noopener noreferrer">{labels.map} ↗</a>
      {rich && <p class="mt-3 text-xs" style="color: var(--text-muted);">{full.siteMap} · {topicArea(lang, slug)}</p>}
    </section>

    {t.faq?.length > 0 && (
      <section class="mt-12">
        <h2 class="font-display text-2xl font-bold mb-4" style="color: var(--text-primary);">{faqTitle}</h2>
        <div class="space-y-3">
          {t.faq.map((item: any) => (
            <details class="card p-5" style="border: 1px solid var(--border-color);">
              <summary class="font-semibold cursor-pointer" style="color: var(--text-primary);">{item.q}</summary>
              <p class="mt-2 text-sm leading-relaxed" style="color: var(--text-secondary);">{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <nav class="mt-12 pt-6 border-t" style="border-color: var(--border-color);">
        <p class="text-xs uppercase tracking-[0.18em] mb-3 font-semibold" style="color: var(--text-muted);">{t.moreLabel ?? 'More visitor guides'}</p>
        <ul class="flex flex-wrap gap-2">
          {related.map((r) => (
            <li>
              <a href={localizedPath(lang, r.slug)} class="inline-block rounded-full px-3 py-1.5 text-sm border hover:opacity-80" style="border-color: var(--border-color); color: var(--text-secondary);">
                {r.title} →
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</article>
